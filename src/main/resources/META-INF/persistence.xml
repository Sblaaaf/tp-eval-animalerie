<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="petstore" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!--CLASS-->
        <class>petstore.entite.Address</class>
        <class>petstore.entite.Animal</class>
        <class>petstore.entite.Fish</class>
        <class>petstore.entite.Cat</class>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>

            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />

            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/petstore" />
            <property name="jakarta.persistence.jdbc.user" value="root" />
            <property name="jakarta.persistence.jdbc.password" value="root" />
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver" />
        </properties>
    </persistence-unit>
</persistence>